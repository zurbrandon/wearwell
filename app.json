{
  "expo": {
    "name": "Wearwell",
    "slug": "wearwell",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wearwell",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.brandonarnold.wearwell",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Wearwell needs access to your photos so you can add pieces to your closet.",
          "cameraPermission": "Wearwell uses the camera to photograph pieces for your closet."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Wearwell uses the camera to photograph pieces for your closet.",
          "microphonePermission": false,
          "recordAudioAndroidPermission": false
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7d7a40d9-6ebe-4938-9dba-f286f3a25427"
      }
    },
    "owner": "brandonarnold"
  }
}
